.tmp/
scratch/
/scratch-*
*.log

# Pengaturan pribadi Claude Code (launch.json tetap dibagikan)
.claude/settings.local.json

# Editor & sistem operasi
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
