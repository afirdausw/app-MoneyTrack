# Server
PORT=3001
APP_URL=http://localhost:5173

# Database MySQL / MariaDB (Laragon / Shared Hosting)
DATABASE_URL=mysql://root:@127.0.0.1:3306/money_tracking

# Auth & Session (ganti dengan string acak panjang di produksi)
SESSION_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Google OAuth (opsional di lokal, isi saat testing login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Upload Struk Privat (disimpan di luar folder public)
UPLOAD_DIR=./uploads/receipts
MAX_RECEIPT_SIZE_MB=5
