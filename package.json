{
  "name": "app-money-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi Money Tracking multi-mode (Pribadi, Pasangan/Komunitas, Freelancer/UMKM) berbasis Fullstack TypeScript",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"node --watch --import tsx src/server/index.ts\" \"vite\"",
    "dev:api": "node --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.server.json --outfile=dist/server/index.js",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "^1.14.1",
    "@hookform/resolvers": "^7.0.6",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.6",
    "lucide-react": "^0.487.0",
    "mysql2": "^3.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.25.2",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
